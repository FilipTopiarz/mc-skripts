    permission: essentials.gamemode
    permission message: ":hexsystem: &cYou don't have permission to use this."
    usage: "/gmsp [player]"
    trigger:
        if arg-1 is set:
            if arg-1 is online:
                set {_target} to arg-1
                set {_target}'s gamemode to spectator
                _setGamemode({_target}, "Spectator", sender)
            else:
                send ":hexsystem: &7Player &b%arg-1%&7 is not &conline!"
        else:
            if sender is a player:
                set player's gamemode to spectator
                _setGamemode(player, "Spectator", sender)
            else:
                send ":hexsystem: &7Usage: &b/gmsp <player>"

command /gamemode [<text>]:
    permission: essentials.gamemode
    trigger:
        if arg-1 is "creative":
            send ":hexsystem: &7Use &b/gmc &7instead"
        else if arg-1 is "survival":
            send ":hexsystem: &7Use &b/gms &7instead"
        else if arg-1 is "adventure":
            send ":hexsystem: &7Use &b/gma &7instead"
        else if arg-1 is "spectator":
            send ":hexsystem: &7Use &b/gmsp &7instead"
        else:
            send ":hexsystem: &7Use &b[/gmc, /gms, /gmsp, /gma] &7instead"