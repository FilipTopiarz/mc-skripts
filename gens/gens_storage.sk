on left click:
    if player does not have permission "gens.admin":
        if name of world of event-block is not "island_%player%":
            send action bar "&8[&c✘&8] &7Sorry, you don't have permission to &c&lbreak blocks&7 here." to player
            play sound "block.anvil.land" with volume 1 and pitch 1 to player
            cancel event
            stop
    loop {storagelist::*}:
        set {_storageName} to loop-value
        set {_itemType} to "%{storagelist::%{_storageName}%::item}%" parsed as item

        if event-block is {_itemType}:
            if breakStorage({_storageName}, player, location of event-block) is 1:
                set event-block to air
            else if breakStorage({_storageName}, player, location of event-block) is 2:
                cancel event

on tab complete of "/storages":
    if tab argument 1 is set: # první argument
        if tab argument 1 is "give":
            set tab completion for position 2 to {storagelist::*}
            set tab completion for position 3 to all players
    else:
        set tab completion for position 1 to "list", "info", "load", "give", "clear"


    
command /storages [<text>] [<text>] [<text>]:
    usage: /storages <list|info|load|give>
    trigger:
        if arg-1 is "list":
            send "&b&lAll storages:"
            loop {storagelist::*}:
                send " "  # prázdný řádek pro oddělení
                send "&b%loop-value%:"  # název generátoru
                loop {storagelist::%loop-value%::*}:
                    if loop-index-2 is "lore":
                        set {_text} to "%{storagelist::%loop-value-1%::lore}%"
                        replace all "[" with "" in {_text}
                        replace all "]" with "" in {_text}
                        set {_lore::*} to split {_text} at ", "
                        send formatted "  %loop-index-2%: <tooltip:%{_lore::*}%>&b[lore]<reset>"
                    else:
                        send formatted "  %loop-index-2%: %loop-value-2%"
                    
                
        if arg-1 is "info":
            if arg-2 is set:
                if {storagelist::%arg-2%::*} is set:
                    send "&bInfo for storage %arg-2%:"
                    loop {storagelist::%arg-2%::*}:
                        send "%loop-index%: %loop-value%"
                else:
                    send "&cThis storage does not exist" to player
            else:
                send "&cYou must specify a storage name" to player

        if arg-1 is "load":
            clear {storagelist::*}
            #loding gens from yaml
            loop yaml node keys "storage" from "storageList":
                send "   " to player
                send "Storage: %loop-key-1%" to player
                add loop-key-1 to {storagelist::*}
                loop yaml node keys "storage.%loop-key-1%" from "storageList":
                    set {_key} to "%loop-key-2%"
                    set {_value} to yaml value "%loop-node-2%" from "%loop-id-2%"
                    send "%{_key}%: %{_value}%" to player
                    set {storagelist::%loop-key-1%::%{_key}%} to {_value}
        
        if arg-1 is "give":
            if arg-2 is set:
                if arg-3 is set:
                    if arg-3 parsed as a player is online:
                        send getStorage(arg-2, arg-3 parsed as a player) to player
                    else:
                        send "&cPlayer is not online"
                else:
                    send getStorage(arg-2, player) to player
            else:
                send "&cYou must specify a storage name" to player

        if arg-1 is "clear":
            if hasPermission(player):
#                loop {allstorageplaced::*}:
#                    set block at loop-value to air
                delete {allstorageplaced::*}
                delete {allstorageplacedPlayer::*}
                loop {storageplaced::*}:
                    set {storageplaced::%loop-index%} to 0
                    delete {storageplaced::%loop-index%::*}

                send "&7All storage blocks have been reset. You now have %{storageplaced::%player's uuid%}% storage blocks" to player

#command /StorageWand:
