function isEnabledStorage(storage: text) :: boolean:
    return {storagelist::%{_storage}%::enabled}


on place:
    if player does not have permission "gens.admin":
        if name of world of event-block is not "island_%player%":
            send action bar "&8[&c✘&8] &7Sorry, you don't have permission to &c&lplace blocks&7 here." to player
            play sound "block.anvil.land" with volume 1 and pitch 1 to player
            cancel event
            stop
    loop {storagelist::*}:
        set {_storageName} to loop-value
        set {_itemType} to "%{storagelist::%{_storageName}%::item}%" parsed as item
        set {_itemName} to "%{storagelist::%{_storageName}%::name}%"

        if type of player's tool is {_itemType}:
            if name of player's tool is {_itemName}:
                if {blockcooldown.%player%} is set:
                    if difference between {blockcooldown.%player%} and now is less than 1 second:
                        cancel event
                        send action bar "&8[&c!&8] &7You can place a storage only once every &c1 second&7." to player
                        play sound "block.anvil.land" with volume 1 and pitch 1 to player
                        stop
                set {blockcooldown.%player%} to now
                if isEnabledStorage({_storageName}):
#                    if {storageplaced::%player's uuid%} >= {maxstorageplaced::%player's uuid%}:
#                        cancel event
#                        send action bar "&8[&c✘&8] &7You have reached the maximum number of storage! &7(&b%{storageplaced::%player's uuid%}%&7/%{maxstorageplaced::%player's uuid%}%)" to player
#                        play sound "block.anvil.land" with volume 1 and pitch 1 to player
#                        stop
#                    else:
                    remove 1 of player's tool from player's inventory
                    placeStorage({_storageName}, player, event-block's location)
#                    cancel event
                    stop
                else:
                    send "%{_itemName}% &7is currently &cdisabled!"
                    cancel event
                    stop

on right click:
    loop {storagelist::*}:
        set {_storageName} to loop-value
        set {_itemType} to "%{storagelist::%{_storageName}%::item}%" parsed as item

        if event-block is {_itemType}:
            #tady kontrola bude te lokace toho bloku
            # if player's held item is air:
            # broadcast "%{allstorageplacedPlayer::%event-block's location%-%player's uuid%}%"
            loop {allstorageplaced::*}:
                if loop-value-2 is "%event-block's location%":
                    if {allstorageplacedPlayer::%event-block's location%-%player's uuid%} is player's uuid:
                        openStorage(player, player)
                        cancel event
                    else:
                        send title "&4&lTHIS IS NOT YOUR STORAGE!" to player for 3 seconds # fadein 1 second fadeout 1 second
                        cancel event
#                else:
#                    if {allstorageplacedPlayer::%event-block's location%} is not player's uuid:
#                        send title "&4&lTHIS IS NOT YOUR STORAGE!" to player for 3 seconds # fadein 1 second fadeout 1 second
#                        cancel event
                    


