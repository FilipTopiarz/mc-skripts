#        if hasPermission(player):
#            give glowing ominous_trial_key named "Storage opener" with lore "&4&lADMIN ONLY" to player

command /CheckStorage [<player>]:
    trigger:
        if hasPermission(player):
            loop {allstorageplacedPlayer::*}:
                if loop-value is arg-1's uuid:
                    set {_target} to arg-1
                    openStorage(player, {_target})
                
command /resetLevel:
    trigger:
        if hasPermission(player):
            set {maxGenLevel.%player%} to 1
            set {maxgenplaced::%player's uuid%} to 20




on inventory click:
    if inventory name is "&c&lStorage":
        cancel event
        if clicked slot is 48:
            openStorageUpgrades(player, player)
        if clicked slot is 49:
            if name of event-item is "&c&lSELL &c&lEVERYTHING":
                if click action is right mouse button:
                    if hasPermission(player):
                        if {toggleAutoSell.%player%} is false:
                            set {toggleAutoSell.%player%} to true
                        else:
                            set {toggleAutoSell.%player%} to false
                        broadcast "%{toggleAutoSell.%player%}%"
                else:
                    execute player command "/gens sellstorage"
                openStorage(player, player)
                

    if inventory name is "&c&lStorage Upgrades":
        cancel event
        if clicked slot is 22:
            openStorage(player, player)
        if clicked slot is 15:
            send ":)" to player
            set {_level} to {maxGenLevel.%player%}
            send "%{_level}%" to player
            set {_CurrentPrice} to ({_level} * 100) * (10 ^ ({_level} - 1) * ((10 ^ ({_level} - 1))))
            send "%{_CurrentPrice}%" to player
            if HasEnoughCurrency(player, "money", {_CurrentPrice}):
                RemovePlayerCurrency(player, "money", {_CurrentPrice})
                set {maxGenLevel.%player%} to {maxGenLevel.%player%} + 1
                set {maxgenplaced::%player's uuid%} to {maxgenplaced::%player's uuid%} + 1
            openStorageUpgrades(player, player)

every 5 second:
    loop all players:
        if {toggleAutoSell.%loop-player%} is true:
            if {maxCapacity::%loop-player's uuid%} = {currentCapacity::%loop-player's uuid%}:
                execute loop-player command "/gens sellstorage"
                send "Storage has been sold" to loop-player


