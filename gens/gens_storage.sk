function breakStorage(n: text, p: player, l: location) :: number:
    if world "island_%{_p}%" is loaded:
        loop {allstorageplaced::*}:
            if loop-value = "%{_l}%":
                if {allstorageplacedPlayer::%{_l}%-%{_p}'s uuid%} is not set:
                    send action bar "&8[&c!&8] &7You can only break your own storage!" to {_p}
                    play sound "block.anvil.land" with volume 1 and pitch 1 to {_p}
                    return 2
        if {allstorageplacedPlayer::%{_l}%-%{_p}'s uuid%} is set:
            remove "%{_l}%" from {allstorageplaced::*}
            delete {allstorageplacedPlayer::%{_l}%-%{_p}'s uuid%}
            remove 1 from {storageplaced::%{_p}'s uuid%}
            send action bar "&8[&a✔&8] &7Successfully taken %{storagelist::%{_n}%::name}% &7(&b%{storageplaced::%{_p}'s uuid%}%&7/%{maxstorageplaced::%{_p}'s uuid%}%)" to {_p}
            draw 10 of smoke particle at {_l} to {_p}
            play sound "entity.item.pickup" with volume 1 and pitch 1 to {_p}
            getStorage({_n}, {_p})
            return 1
    else:
        broadcast "svet neni loaded" 
    return 3

#        loop {storageplaced::%{_p}'s uuid%::%{_n}%::*}:
#            if loop-value is {_l}:
#                remove {_l}'s location from {storageplaced::%{_p}'s uuid%::%{_n}%::*}
#                remove {_l}'s location from {allstorageplaced::*}
#                delete {allstorageplacedPlayer::%{_l}%}
#                remove 1 from {storageplaced::%{_p}'s uuid%}
#                send action bar "&8[&a✔&8] &7Successfully taken %{storagelist::%{_n}%::name}% &7(&b%{storageplaced::%{_p}'s uuid%}%&7/%{maxstorageplaced::%{_p}'s uuid%}%)" to {_p}
#                draw 10 of smoke particle at {_l} to {_p}
#                play sound "entity.item.pickup" with volume 1 and pitch 1 to {_p}
#                getStorage({_n}, {_p})
#                return 1
#        return 3

function openStorage(p: player, pstorage: player): #prvni je ten komu se inv otevre, druhy ten koho to je storage
    set {_invfullness} to ({currentCapacity::%{_p}'s uuid%} / {maxCapacity::%{_p}'s uuid%}) * 100
    if {_invfullness} <= 33:
        set {_invfprfx} to "&a&l" 
    else if {_invfullness} <= 66:
        set {_invfprfx} to "&6&l" 
    else:
        set {_invfprfx} to "&4&l" 
    set {_invfsufx} to "&8%% Full"

    set {_openInv} to a chest inventory with 6 rows named "&c&lStorage" #"%{_invfprfx}%%{_invfullness}%%{_invfsufx}% "
    # Top Border
    loop 9 times:
        set slot (loop-number - 1) of {_openInv} to light_blue_stained_glass_pane named " "
    # Inventory

    set {_i} to 1
    loop {playerStorage::%{_p}'s uuid%::*}:
        set {_formattedPrice} to customFormatNumber({playerStorage::%{_p}'s uuid%::%loop-index%::price})
        set slot ({_i} + 8) of {_openInv} to loop-index parsed as item named "%loop-value%x %loop-index%" with lore "&fSell price: %{_formattedPrice}%"
        set {_i} to {_i} + 1
###        send "%loop-index%: %loop-value%"
#    loop 27 times:
#        set slot (loop-number + 8) of {_openInv} to structure_void named "&4Locked Item"

    # Fullness bar
    loop 9 times:
        if loop-number <= ({_invfullness} / 9):
            if {_invfullness} <= 33:
                set slot (loop-number + 35) of {_openInv} to lime_stained_glass_pane named "%{_invfprfx}%%{_invfullness}%%{_invfsufx}%"
            else if {_invfullness} <= 66:
                set slot (loop-number + 35) of {_openInv} to orange_stained_glass_pane named "%{_invfprfx}%%{_invfullness}%%{_invfsufx}%"
            else:
                set slot (loop-number + 35) of {_openInv} to red_stained_glass_pane named "%{_invfprfx}%%{_invfullness}%%{_invfsufx}%"
        else:
            set slot (loop-number + 35) of {_openInv} to light_blue_stained_glass_pane named "%{_invfprfx}%%{_invfullness}%%{_invfsufx}%"
    # Footer bar
# UPGRADE    set slot 45 of {_openInv} to paper named "&bPrevious page"
    if {_pstorage} is {_p}:
        set slot 48 of {_openInv} to book named "&r&k*** &4Upgrades &r&k***"
        if {toggleAutoSell.%{_p}%} is false:
            set slot 49 of {_openInv} to glowing sunflower named "&c&lSELL &c&lEVERYTHING" with lore "Press with right click to toggle", "auto-sell when storage is full", "&6(Only VIP)" and "&4■■"
        else if {toggleAutoSell.%{_p}%} is true:
            set slot 49 of {_openInv} to glowing sunflower named "&c&lSELL &c&lEVERYTHING" with lore "Press with right click to toggle", "auto-sell when storage is full", "&6(Only VIP)" and "&a■■"
    else:
        set slot 48 of {_openInv} to glowing barrier named "&r&k*** &4&mUpgrades&r &r&k***" with lore "&4&lLocked!"
        set slot 49 of {_openInv} to glowing barrier named "&c&l&mSELL&r &c&mEVERYTHING" with lore "&4&lLocked!"
    set slot 50 of {_openInv} to pale_oak_sign named "&4Info" with lore "Owner: %{_pstorage}%" and "Size: %{maxCapacity::%{_pstorage}'s uuid%}%"
# UPGRADE    set slot 53 of {_openInv} to paper named "&4Next page"
    open {_openInv} to {_p}

function openStorageUpgrades(p: player, pstorage: player):
    set {_openInv} to a chest inventory with 3 rows named "&c&lStorage Upgrades"

    # Upgrade slots
    loop 18 times:
        if loop-number is 12 or 16:
            if loop-number is 12:
                set slot (loop-number - 1) of {_openInv} to skull_banner_pattern named "&c&lUpgrade Storage" with lore "Current max: " and "Current level: " and "Price for upgrade: "
            else if loop-number is 16:
                # set {_CurrentPrice} to ({maxGenLevel.%{_pstorage}%} * 100) * 10^%{maxGenLevel.%{_pstorage}%}
                set {_level} to {maxGenLevel.%{_pstorage}%}
                set {_CurrentPrice} to ({_level} * 100) * (10 ^ ({_level} - 1) * ((10 ^ ({_level} - 1))))
                set {_formattedPrice} to customFormatNumber({_CurrentPrice})
                set slot (loop-number - 1) of {_openInv} to skull_banner_pattern named "&c&lUpgrade Generators" with lore "Current max: %{maxgenplaced::%{_pstorage}'s uuid%}%" and "Current level: %{maxGenLevel.%{_pstorage}%} - 1%" and "Price for upgrade: %{_formattedPrice}%"
        else:
            set slot (loop-number - 1) of {_openInv} to gray_stained_glass_pane named " "

    # Footer bar
    loop 9 times:
        set slot (loop-number + 17) of {_openInv} to light_blue_stained_glass_pane named " "
    set slot 22 of {_openInv} to book named "&r&k*** &4Back to Storage &r&k***"
    open {_openInv} to {_p}


function getStorage(storage: text, p: player) :: text:
    if {storagelist::%{_storage}%::*} is set:
        set {_text} to "%{storagelist::%{_storage}%::lore}%"
        replace all "[" with "" in {_text}
        replace all "]" with "" in {_text}
        set {_lore::*} to split {_text} at ", "
        give {_p} "%{storagelist::%{_storage}%::item}%" parsed as item named "%{storagelist::%{_storage}%::name}%" with lore formatted {_lore::*}
        return "&7Hrac &b%{_p}% &7Dostal storage %{storagelist::%{_storage}%::name}%"
    else:
        return "&cThis storage does not exist"


command /storageadmin [<text>]:
    trigger:
        if arg-1 is set:
            give player {storage::%arg-1%}
        else:
            send "&cNenasel se storage :(" to player

