placeholderapi placeholder with the prefix "storage":
    if the identifier is "maxCapacity":
        set the result to "%{maxCapacity::%player's uuid%}%"
    if the identifier is "currentCapacity":
        set the result to "%{currentCapacity::%player's uuid%}%"

on join:
    if {maxCapacity::%player's uuid%} is not set:
        set {maxCapacity::%player's uuid%} to 100
    if {currentCapacity::%player's uuid%} is not set:
        set {currentCapacity::%player's uuid%} to 0
    if {playerStorage::%player's uuid%} is not set:
        set {playerStorage::%player's uuid%} to player's uuid

    if {maxstorageplaced::%player's uuid%} is not set:
        set {maxstorageplaced::%player's uuid%} to 1
    if {storageplaced::%player's uuid%} is not set:
        set {storageplaced::%player's uuid%} to 0 
    
    if {toggleAutoSell.%player%} is not set:
        set {toggleAutoSell.%player%} to false

    if {maxGenLevel.%player%} is not set:
        set {maxGenLevel.%player%} to 1
    if {maxStorageLevel.%player%} is not set:
        set {maxStorageLevel.%player%} to 1
    

on load:
    load yaml "plugins/Skript/scripts/gens/configs/storageList.yaml" as "storageList"
    clear {storagelist::*}
    #loding gens from yaml
    loop yaml node keys "storage" from "storageList":
        send "   " to player
        send "Storage: %loop-key-1%" to player
        add loop-key-1 to {storagelist::*}
        loop yaml node keys "storage.%loop-key-1%" from "storageList":
            set {_key} to "%loop-key-2%"
            set {_value} to yaml value "%loop-node-2%" from "%loop-id-2%"
            send "%{_key}%: %{_value}%" to player
            set {storagelist::%loop-key-1%::%{_key}%} to {_value}

#function placeStorage(n: text, p: player, l: location):
#    add {_l}'s location to {storageplaced::%{_n}%::%{_p}' uuid%::*}
#    send "polozil jsi storage lol" to {_p}

function placeStorage(n: text, p: player, l: location):
    if world "island_%{_p}%" is loaded:
        if {storageplaced::%{_p}'s uuid%} >= {maxstorageplaced::%{_p}'s uuid%}:
            getStorage({_n}, {_p})
            send action bar "&8[&c✘&8] &7You have reached the maximum number of storage blocks! &7(&b%{storageplaced::%{_p}'s uuid%}%&7/%{maxstorageplaced::%{_p}'s uuid%}%)" to {_p}
            play sound "block.anvil.land" with volume 1 and pitch 1 to {_p}   
            stop
        add "%{_l}%" to {allstorageplaced::*}
        set {allstorageplacedPlayer::%{_l}%-%{_p}'s uuid%} to {_p}'s uuid
        add 1 to {storageplaced::%{_p}'s uuid%}

#        add {_l}'s location to {storageplaced::%{_p}'s uuid%::%{_n}%::*}
#        add {_l} to {allstorageplaced::*}
#        set {allstorageplacedPlayer::%{_l}%} to {_p}'s uuid
#        add 1 to {storageplaced::%{_p}'s uuid%}

        send action bar "&8[&a✔&8] &7Successfully placed %{storagelist::%{_n}%::name}% &7(&b%{storageplaced::%{_p}'s uuid%}%&7/%{maxstorageplaced::%{_p}'s uuid%}%)" to {_p}
        play sound "entity.experience_orb.pickup" with volume 1 and pitch 1 to {_p}
#    set block at {_l} to {storagelist::%{_n}%::item} parsed as item type
    
#    draw 10 of smoke particle at {_l} with offset vector(0, 1, 0) to {_p}
#    set {_ent} to last spawned entity
#    set gravity of {_ent} to true
#    set velocity of {_ent} to vector(0,0,0) # normální pád

